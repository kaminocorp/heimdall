# Required
DATABASE_URL=postgres://heimdall:heimdall@localhost:5432/heimdall?sslmode=disable
ANTHROPIC_API_KEY=
SUPABASE_URL=https://your-project.supabase.co

# RLS role-split (Phase 3 wires the topology; Phase 6 flips the URLs to
# point at distinct runtime roles). Until Phase 6, leave both blank — the
# server falls back to DATABASE_URL with a startup WARN, and migrations
# fall back to DATABASE_URL silently.
#
# Phase 6 end-state:
#   DATABASE_URL       → app_user (per-tenant CRUD, RLS enforced)
#   CRON_DATABASE_URL  → cron_user (cross-tenant SELECT, narrow writes, BYPASSRLS)
#   DIRECT_URL         → postgres (superuser, used by `make migrate-*`)
#
# Phase 6 example fill (uncomment + substitute passwords once Phase 4
# bootstrap has run; see docs/completions/rls-enforcement-phase-6.md):
# DATABASE_URL=postgres://app_user:<password>@localhost:5432/heimdall?sslmode=disable
# CRON_DATABASE_URL=postgres://cron_user:<password>@localhost:5432/heimdall?sslmode=disable
# DIRECT_URL=postgres://postgres:<password>@localhost:5432/heimdall?sslmode=disable
CRON_DATABASE_URL=
DIRECT_URL=

# Set to "production" to enable startup invariants (e.g. role-split check).
# Leave blank in dev — the role-split check would fail today because both
# pools still authenticate as the same role.
#
# Phase 6 turns this on in production in the SAME secrets-update transaction
# as the URL flip, so the first post-flip boot fails-closed if either pool
# didn't pick up the new role. See main.go:79-84 (assertRoleSplit).
HEIMDALL_ENV=

# Optional
PORT=8080
LOG_FORMAT=text             # "text" (default) or "json" for structured log aggregators
ELEPHANTASM_URL=
ELEPHANTASM_API_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Frontend (prefix with VITE_ for Vite exposure)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Set to any value to disable background jobs (monitor, scheduler, pollers).
# Useful for local dev against a production database.
# DISABLE_BACKGROUND_JOBS=true
